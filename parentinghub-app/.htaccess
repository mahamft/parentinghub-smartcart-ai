Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# WordPress staging lives in /wp-build. Let its own .htaccess handle all
# nested WordPress routes (including pretty permalinks) instead of the PHP app router.
RewriteRule ^wp-build(?:/|$) - [L]

# Canonical homepage
RewriteRule ^index\.html$ / [R=301,L]

# Do not loop the front controller
RewriteRule ^index\.php$ - [L]

# Admin is a real directory, but its PHP entry requires PH_ENTRY from the app router.
# Route /admin and /admin-panel through the front controller before the -d bypass below.
RewriteRule ^(?:admin|admin-panel)(?:/.*)?$ index.php [QSA,L]

# Let real files/directories be handled normally.
# Sensitive implementation directories have their own deny rules.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else goes through the PHP router
RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
