# ==============================================================================
# ParentingHub SmartCart AI - Environment Configuration Template
# Copy this file to backend/.env and populate your credentials.
# NEVER commit .env to public version control!
# ==============================================================================

# Application Environment ('local', 'staging', 'production')
APP_ENV=local
APP_DEBUG=1

# Local Database Configuration (MariaDB / MySQL 8.0+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=parentinghub_db
DB_USER=root
DB_PASS=

# Allowed CORS Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000
SESSION_DAYS=30

# Admin Bootstrap Credentials (Required: Set a unique, strong password before running bootstrap)
ADMIN_BOOTSTRAP_EMAIL=admin@parentinghub.pk
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_TO_A_SECURE_UNIQUE_PASSWORD
ADMIN_BOOTSTRAP_NAME=ParentingHub Admin

# PayPal Orders v2 API Configuration
# PAYPAL_MODE: 'sandbox' (live sandbox API), 'mock' (instant simulated testing), or 'live'
PAYPAL_MODE=sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=YOUR_PAYPAL_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_SANDBOX_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID
PAYPAL_MERCHANT_ID=
PAYPAL_FX_PKR_USD=280.0000

# Google Gemini AI Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
AI_MODEL=gemini-3.5-flash-lite

# Qdrant Vector Database Configuration (Hybrid Semantic Search)
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=parentinghub_knowledge
QDRANT_API_KEY=

